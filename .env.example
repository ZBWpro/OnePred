# WandB
WANDB_API_KEY=your_wandb_api_key_here

# LLM Judge API
LLM_API_KEY=your_llm_api_key_here

# Model API URLs (for multi-model judge)
CLAUDE_API_URL=https://your-api-endpoint/claude/chat/completions
CLAUDE_37_API_URL=https://your-api-endpoint/claude-37/chat/completions
CLAUDE_CACHE_API_URL=https://your-api-endpoint/claude-cache/chat/completions
GEMINI_API_URL=https://your-api-endpoint/gemini/chat/completions
GPT_API_URL=https://your-api-endpoint/gpt/chat/completions

# Paths
BASE_DIR=/path/to/your/workspace
MODEL_DIR=/path/to/your/models
DATA_DIR=/path/to/your/data
ONEPRED_ROOT=/path/to/OnePred
